# COMUNIDAD 360 — ejemplo de configuración
#
# Configuración de desarrollo local de FASE 2. No contiene secretos reales.
# Nunca confirmar un .env real en Git.

# --- Aplicación ---
SPRING_PROFILES_ACTIVE=local
APP_NAME=Comunidad360
APP_ENV=local
APP_PORT=8080
VITE_API_BASE_URL=http://localhost:8080/api/v1
APP_BASE_URL=http://localhost:8080
APP_FRONTEND_URL=http://localhost:5173
APP_DEFAULT_LANGUAGE=es
APP_SUPPORTED_LANGUAGES=es,ca
APP_TIMEZONE=Europe/Madrid
APP_CURRENCY=EUR

# --- PostgreSQL ---
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/comunidad360
SPRING_DATASOURCE_USERNAME=comunidad360
SPRING_DATASOURCE_PASSWORD=comunidad360_local
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
SPRING_FLYWAY_ENABLED=true

# --- Docker Compose local (infraestructura, no producción) ---
POSTGRES_DB=comunidad360
POSTGRES_USER=comunidad360
POSTGRES_PASSWORD=comunidad360_local
S3_BUCKET=comunidad360-documents
BACKEND_HTTP_PORT=8080
FRONTEND_HTTP_PORT=3000

# --- Seguridad / JWT ---
# Generar un valor aleatorio robusto en cada entorno.
APP_SECURITY_JWT_SECRET=cambiar_por_un_secreto_largo_y_aleatorio
APP_SECURITY_ACCESS_TOKEN_TTL_SECONDS=900
APP_SECURITY_REFRESH_TOKEN_TTL_DAYS=30
APP_SECURITY_COOKIE_SECURE=false
APP_SECURITY_COOKIE_SAME_SITE=Lax
APP_SECURITY_EXPOSE_DEV_TOKENS=true
APP_RATE_LIMIT_ENABLED=true
APP_RATE_LIMIT_AUTH_PER_MINUTE=30
APP_RATE_LIMIT_GENERAL_PER_MINUTE=300
APP_MALWARE_SCAN_ENABLED=false
APP_MALWARE_SCAN_HOST=localhost
APP_MALWARE_SCAN_PORT=3310
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:3000,http://localhost:13000,http://127.0.0.1:13000

# --- Datos de desarrollo (solo perfil local) ---
APP_SEED_ENABLED=true
APP_SEED_ADMIN_EMAIL=admin@comunidad360.local
APP_SEED_ADMIN_PASSWORD=Admin1234!
APP_SEED_COMMUNITY_NAME=Comunidad Demo

# --- Bootstrap de producción (primer administrador) ---
APP_BOOTSTRAP_ENABLED=false
APP_BOOTSTRAP_EMAIL=
APP_BOOTSTRAP_PASSWORD=
APP_BOOTSTRAP_COMMUNITY_NAME=Comunidad Principal

# --- Email (desarrollo) ---
APP_MAIL_ENABLED=true
SPRING_MAIL_HOST=localhost
SPRING_MAIL_PORT=1025
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
APP_MAIL_FROM=no-reply@comunidad360.local
APP_MAIL_FROM_NAME=Comunidad 360

# --- Almacenamiento S3 compatible ---
APP_STORAGE_S3_ENDPOINT=http://localhost:9090
APP_STORAGE_S3_PUBLIC_ENDPOINT=http://localhost:9090
APP_STORAGE_S3_REGION=us-east-1
APP_STORAGE_S3_BUCKET=comunidad360-documents
APP_STORAGE_S3_ACCESS_KEY=test
APP_STORAGE_S3_SECRET_KEY=test
APP_STORAGE_S3_PATH_STYLE=true
APP_STORAGE_SIGNED_URL_TTL_SECONDS=300
APP_STORAGE_LOCAL_PATH=./data/uploads
APP_STORAGE_MAX_INCIDENT_PHOTO_BYTES=5242880

# --- Límites de archivos (propuesta, pendiente Q-13) ---
APP_DOCUMENTS_MAX_SIZE_BYTES=10485760
APP_DOCUMENTS_ALLOWED_TYPES=application/pdf,image/jpeg,image/png,text/plain

# --- Redis (opcional) ---
APP_REDIS_ENABLED=false
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379

# --- Banca CSV (propuesta) ---
APP_BANK_IMPORT_MAX_ROWS=10000

# --- Observabilidad ---
APP_LOG_LEVEL=INFO
APP_TRACING_ENABLED=false

# --- IA (POST-MVP) ---
APP_AI_ENABLED=false
# APP_AI_PROVIDER=
# APP_AI_API_KEY=
